---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

const authors = [...new Set(posts.map((post) => post.data.author))].sort();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
const groups = [...new Set(posts.map((post) => post.data.group))].sort();
---

<BaseLayout title="dplvoah blog" description="Minimal blog with discussion workflow and AI collaboration.">
  <section class="intro">
    <p class="mono">/blog</p>
    <h1>Thoughts, experiments, and open discussion.</h1>
    <p class="lead">
      This blog keeps the writing minimal and the interaction practical. Posts, comments, and
      replies are all connected with GitHub Discussions.
    </p>
  </section>

  <section class="meta-grid">
    <section class="card block">
      <h2>Logo Links</h2>
      <div class="quick-links">
        <a href="https://github.com/dplvoah" target="_blank" rel="noreferrer noopener">GitHub Profile</a>
        <a
          href="https://github.com/dplvoah/dplvoah.github.io"
          target="_blank"
          rel="noreferrer noopener"
        >
          Blog Repository
        </a>
      </div>
    </section>

    <section class="card block">
      <h2>Contact</h2>
      <ul class="contact-list">
        <li>
          Email 1:
          <a href="mailto:imlevv@outlook.com">imlevv@outlook.com</a>
        </li>
        <li>
          Email 2:
          <a href="mailto:dplvoah@gmail.com">dplvoah@gmail.com</a>
        </li>
        <li>WeChat ID: <span class="mono soft-strong">hellolevv</span></li>
      </ul>
    </section>
  </section>

  <section class="card filters">
    <h2>Filter Posts</h2>
    <div class="filters-grid">
      <label>
        <span>Author</span>
        <select id="filter-author">
          <option value="all">All</option>
          {authors.map((author) => (
            <option value={author}>{author}</option>
          ))}
        </select>
      </label>
      <label>
        <span>Tag</span>
        <select id="filter-tag">
          <option value="all">All</option>
          {tags.map((tag) => (
            <option value={tag}>{tag}</option>
          ))}
        </select>
      </label>
      <label>
        <span>Group</span>
        <select id="filter-group">
          <option value="all">All</option>
          {groups.map((group) => (
            <option value={group}>{group}</option>
          ))}
        </select>
      </label>
    </div>
    <p class="result-line">
      Matched posts: <strong id="result-count">{posts.length}</strong>
    </p>
  </section>

  <section id="posts">
    <ul class="post-list">
      {posts.map((post) => (
        <li
          class="post-item"
          data-post-item
          data-author={post.data.author}
          data-tags={post.data.tags.join(",")}
          data-group={post.data.group}
        >
          <a class="post-title" href={`/blog/${post.id}/`}>{post.data.title}</a>
          <p class="post-excerpt">{post.data.description ?? "No excerpt provided."}</p>
          <div class="post-meta">
            <span>{post.data.pubDate.toLocaleDateString("en-US")}</span>
            <span>Author: {post.data.author}</span>
            <span>Group: {post.data.group}</span>
          </div>
          <div class="tag-row">
            {post.data.tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <p class="card empty-state" id="empty-state" hidden>
    No posts match the selected filters.
  </p>
</BaseLayout>

<script is:inline>
  const authorSelect = document.querySelector("#filter-author");
  const tagSelect = document.querySelector("#filter-tag");
  const groupSelect = document.querySelector("#filter-group");
  const postItems = Array.from(document.querySelectorAll("[data-post-item]"));
  const resultCount = document.querySelector("#result-count");
  const emptyState = document.querySelector("#empty-state");

  function applyFilters() {
    const authorValue = authorSelect?.value ?? "all";
    const tagValue = tagSelect?.value ?? "all";
    const groupValue = groupSelect?.value ?? "all";
    let visibleCount = 0;

    postItems.forEach((item) => {
      const itemAuthor = item.getAttribute("data-author");
      const itemGroup = item.getAttribute("data-group");
      const itemTags = (item.getAttribute("data-tags") ?? "").split(",");
      const isVisible =
        (authorValue === "all" || itemAuthor === authorValue) &&
        (groupValue === "all" || itemGroup === groupValue) &&
        (tagValue === "all" || itemTags.includes(tagValue));

      item.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    });

    if (resultCount) resultCount.textContent = String(visibleCount);
    if (emptyState) emptyState.hidden = visibleCount > 0;
  }

  [authorSelect, tagSelect, groupSelect].forEach((control) =>
    control?.addEventListener("change", applyFilters)
  );

  applyFilters();
</script>

<style>
  .intro {
    margin-bottom: 28px;
  }

  .mono {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.84rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-family: "DM Mono", "Cascadia Mono", monospace;
  }

  h1 {
    margin: 10px 0 10px;
    font-size: clamp(2rem, 5vw, 2.9rem);
    letter-spacing: -0.02em;
  }

  .lead {
    margin: 0;
    max-width: 66ch;
    color: var(--text-soft);
  }

  .meta-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-bottom: 12px;
  }

  .block h2 {
    margin: 0 0 10px;
    font-size: 1rem;
    letter-spacing: 0.01em;
  }

  .quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .quick-links a {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px 11px;
    text-decoration: none;
    font-size: 0.88rem;
  }

  .contact-list {
    margin: 0;
    padding-left: 17px;
    display: grid;
    gap: 5px;
  }

  .contact-list li {
    color: var(--text-soft);
    font-size: 0.92rem;
  }

  .soft-strong {
    color: var(--text);
    letter-spacing: 0.04em;
  }

  .filters {
    margin-bottom: 12px;
  }

  .filters h2 {
    margin: 0 0 10px;
    font-size: 1rem;
  }

  .filters-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }

  label span {
    display: block;
    font-size: 0.84rem;
    margin-bottom: 6px;
    color: var(--text-soft);
  }

  select {
    width: 100%;
    min-height: 36px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--text);
    padding: 0 10px;
    font: inherit;
    font-size: 0.9rem;
  }

  .result-line {
    margin: 10px 0 0;
    font-size: 0.88rem;
    color: var(--text-soft);
  }

  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .post-item {
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }

  .post-title {
    display: inline-block;
    color: var(--text);
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .post-title:hover {
    text-decoration: underline;
  }

  .post-excerpt {
    margin: 8px 0 0;
    color: var(--text-soft);
    font-size: 0.94rem;
  }

  .post-meta {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    font-size: 0.82rem;
    color: var(--text-soft);
  }

  .tag-row {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 2px 9px;
    font-size: 0.76rem;
    color: var(--text-soft);
  }

  .empty-state {
    margin-top: 12px;
    font-size: 0.9rem;
    color: var(--text-soft);
  }

  @media (min-width: 840px) {
    .meta-grid {
      grid-template-columns: 1.1fr 1fr;
    }

    .filters-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
