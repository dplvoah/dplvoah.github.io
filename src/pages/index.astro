---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>dplvoah blog</title>
    <style>
      :root {
        color-scheme: dark;
      }

      body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #0b0b0b;
        color: #f5f5f5;
      }

      .container {
        max-width: 760px;
        margin: 0 auto;
        padding: 48px 20px 80px;
      }

      h1 {
        margin-bottom: 12px;
      }

      p {
        color: #c7c7c7;
      }

      ul {
        list-style: none;
        padding: 0;
        margin-top: 32px;
      }

      li {
        padding: 20px 0;
        border-bottom: 1px solid #27272a;
      }

      a {
        color: #f5f5f5;
        text-decoration: none;
        font-size: 22px;
      }

      a:hover {
        text-decoration: underline;
      }

      .meta {
        margin-top: 8px;
        color: #a1a1aa;
        font-size: 14px;
      }
    </style>
  </head>
  <body>
    <main class="container">
      <h1>dplvoah blog</h1>
      <p>My personal blog built with Astro.</p>

      <ul>
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
            <div class="meta">
              {post.data.pubDate.toLocaleDateString("en-US")}
            </div>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>