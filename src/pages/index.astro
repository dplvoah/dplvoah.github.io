---
import { getCollection } from "astro:content";
import { HomeLayout } from "charm:layouts";

const posts = (await getCollection(
  "posts",
  ({ data }) =>
    (!data.hidden || !import.meta.env.PROD) &&
    (import.meta.env.PROD ? data.draft !== true : true),
)).sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

const authors = [...new Set(posts.map((post) => post.data.author))].sort();
const tags = [...new Set(posts.flatMap((post) => post.data.tags ?? []))].sort();
const groups = [...new Set(posts.map((post) => post.data.group ?? post.data.category))].sort();

function resolveRouteSlug(post: { id: string; filePath?: string }) {
  const filePath = post.filePath ?? "";
  const match = /\/([^/]+)\.mdx?$/i.exec(filePath);
  return match?.[1] ?? post.id;
}
---

<HomeLayout useH1 meta={{ title: "dplvoah blog", description: "Thoughts, experiments, and open discussion." }}>
  <section class="intro">
    <p class="mono">/blog</p>
    <h2>Thoughts, experiments, and open discussion.</h2>
    <p class="lead">
      This blog keeps writing minimal and interaction practical. Posts, comments, and follow-up replies are all
      connected through GitHub Discussions.
    </p>
  </section>

  <section class="meta-grid">
    <section class="panel">
      <h3>Links</h3>
      <div class="quick-links">
        <a href="https://github.com/dplvoah" target="_blank" rel="noreferrer noopener">GitHub Profile</a>
        <a href="https://github.com/dplvoah/dplvoah.github.io" target="_blank" rel="noreferrer noopener">
          Blog Repository
        </a>
      </div>
    </section>

    <section class="panel">
      <h3>Contact</h3>
      <ul class="contact-list">
        <li>
          Email 1:
          <a href="mailto:imlevv@outlook.com">imlevv@outlook.com</a>
        </li>
        <li>
          Email 2:
          <a href="mailto:dplvoah@gmail.com">dplvoah@gmail.com</a>
        </li>
        <li>WeChat ID: <span class="mono">hellolevv</span></li>
      </ul>
    </section>
  </section>

  <section class="panel filters">
    <h3>Filter Posts</h3>
    <div class="filters-grid">
      <label>
        <span>Author</span>
        <select id="filter-author">
          <option value="all">All</option>
          {authors.map((author) => (
            <option value={author}>{author}</option>
          ))}
        </select>
      </label>
      <label>
        <span>Tag</span>
        <select id="filter-tag">
          <option value="all">All</option>
          {tags.map((tag) => (
            <option value={tag}>{tag}</option>
          ))}
        </select>
      </label>
      <label>
        <span>Group</span>
        <select id="filter-group">
          <option value="all">All</option>
          {groups.map((group) => (
            <option value={group}>{group}</option>
          ))}
        </select>
      </label>
    </div>
    <p class="result-line">
      Matched posts: <strong id="result-count">{posts.length}</strong>
    </p>
  </section>

  <section id="posts">
    <ul class="post-list">
      {posts.map((post) => (
        <li
          class="post-item"
          data-post-item
          data-author={post.data.author}
          data-tags={(post.data.tags ?? []).join(",")}
          data-group={post.data.group ?? post.data.category}
        >
          <a class="post-title link-animate" href={`/blog/${resolveRouteSlug(post)}/`}>
            {post.data.title}
          </a>
          <p class="post-excerpt">{post.data.description ?? "No excerpt provided."}</p>
          <div class="post-meta">
            <span>{post.data.published.toLocaleDateString("en-US")}</span>
            <span>Author: {post.data.author}</span>
            <span>Group: {post.data.group ?? post.data.category}</span>
          </div>
          {(post.data.tags ?? []).length > 0 && (
            <div class="tag-row">
              {(post.data.tags ?? []).map((tag) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          )}
        </li>
      ))}
    </ul>
  </section>

  <p class="panel empty-state" id="empty-state" hidden>
    No posts match the selected filters.
  </p>
</HomeLayout>

<script is:inline>
  const authorSelect = document.querySelector("#filter-author");
  const tagSelect = document.querySelector("#filter-tag");
  const groupSelect = document.querySelector("#filter-group");
  const postItems = Array.from(document.querySelectorAll("[data-post-item]"));
  const resultCount = document.querySelector("#result-count");
  const emptyState = document.querySelector("#empty-state");

  function applyFilters() {
    const authorValue = authorSelect?.value ?? "all";
    const tagValue = tagSelect?.value ?? "all";
    const groupValue = groupSelect?.value ?? "all";
    let visibleCount = 0;

    postItems.forEach((item) => {
      const itemAuthor = item.getAttribute("data-author");
      const itemGroup = item.getAttribute("data-group");
      const itemTags = (item.getAttribute("data-tags") ?? "").split(",");
      const isVisible =
        (authorValue === "all" || itemAuthor === authorValue) &&
        (groupValue === "all" || itemGroup === groupValue) &&
        (tagValue === "all" || itemTags.includes(tagValue));

      item.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    });

    if (resultCount) resultCount.textContent = String(visibleCount);
    if (emptyState) emptyState.hidden = visibleCount > 0;
  }

  [authorSelect, tagSelect, groupSelect].forEach((control) =>
    control?.addEventListener("change", applyFilters),
  );

  applyFilters();
</script>

<style>
  .intro {
    margin-bottom: 1.6rem;
  }

  .mono {
    opacity: 0.75;
    letter-spacing: 0.05em;
  }

  .intro h2 {
    margin: 0.2rem 0 0.5rem;
  }

  .lead {
    max-width: 72ch;
    opacity: 0.9;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
    margin-bottom: 0.8rem;
  }

  .panel {
    border-radius: 0.6rem;
    padding: 1rem;
    border: 1px solid var(--charm-contrast-color-2);
    background: color-mix(in oklab, var(--charm-bg-color) 94%, var(--charm-contrast-color-2));
  }

  .panel h3 {
    margin-top: 0;
    margin-bottom: 0.8rem;
  }

  .quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .quick-links a {
    border: 1px solid var(--charm-contrast-color-3);
    border-radius: 999px;
    padding: 0.32rem 0.75rem;
    text-decoration: none;
  }

  .contact-list {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.35rem;
  }

  .filters-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
  }

  label span {
    display: block;
    margin-bottom: 0.35rem;
    opacity: 0.85;
    font-size: 0.92rem;
  }

  select {
    width: 100%;
    min-height: 2.2rem;
    border-radius: 0.45rem;
    border: 1px solid var(--charm-contrast-color-3);
    background: var(--charm-bg-color);
    color: var(--charm-font-color);
    padding: 0 0.7rem;
    font: inherit;
  }

  .result-line {
    margin: 0.75rem 0 0;
    opacity: 0.85;
  }

  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--charm-contrast-color-2);
  }

  .post-item {
    padding: 1rem 0;
    border-bottom: 1px solid var(--charm-contrast-color-2);
  }

  .post-title {
    display: inline-block;
    font-size: 1.08rem;
    text-decoration: none;
    margin-bottom: 0.35rem;
  }

  .post-excerpt {
    margin: 0.2rem 0 0.5rem;
    opacity: 0.85;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.85rem;
    font-size: 0.9rem;
    opacity: 0.8;
  }

  .tag-row {
    margin-top: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tag {
    border-radius: 999px;
    border: 1px solid var(--charm-contrast-color-3);
    padding: 0.14rem 0.5rem;
    font-size: 0.82rem;
    opacity: 0.85;
  }

  .empty-state {
    margin-top: 0.8rem;
    opacity: 0.85;
  }

  @media (min-width: 50rem) {
    .meta-grid {
      grid-template-columns: 1.1fr 1fr;
    }

    .filters-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
