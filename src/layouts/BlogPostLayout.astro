---
import GiscusComments from "../components/GiscusComments.astro";
import PostShare from "../components/PostShare.astro";
import BaseLayout from "./BaseLayout.astro";

interface Frontmatter {
  title: string;
  description?: string;
  pubDate?: string | Date;
  author: string;
  tags: string[];
  group: string;
  discussionId?: string;
}

interface Props {
  frontmatter: Frontmatter;
  slug: string;
}

const { frontmatter, slug } = Astro.props as Props;
const site = Astro.site ?? new URL("https://dplvoah.github.io");
const articleUrl = new URL(`/blog/${slug}/`, site).toString();
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <p class="back-link">
    <a href="/">Back to home</a>
  </p>

  <header class="post-header">
    <p class="mono">/blog/{slug}</p>
    <h1>{frontmatter.title}</h1>
    {frontmatter.description && <p class="description">{frontmatter.description}</p>}
    <div class="meta">
      <span>{frontmatter.pubDate && new Date(frontmatter.pubDate).toLocaleDateString("en-US")}</span>
      <span>Author: {frontmatter.author}</span>
      <span>Group: {frontmatter.group}</span>
    </div>
    <div class="tag-row">
      {frontmatter.tags.map((tag) => (
        <span class="tag">#{tag}</span>
      ))}
    </div>
  </header>

  <article class="post-article">
    <slot />
  </article>

  <PostShare title={frontmatter.title} description={frontmatter.description} url={articleUrl} />

  <section class="card comments-card">
    <h2>Discussion</h2>
    <p class="comment-note">
      You can reply directly below. For deeper threaded responses, open the GitHub discussion.
    </p>
    <GiscusComments />
  </section>
</BaseLayout>

<style>
  .back-link {
    margin: 0 0 20px;
    font-size: 0.9rem;
  }

  .mono {
    margin: 0;
    color: var(--text-soft);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.78rem;
    font-family: "DM Mono", "Cascadia Mono", monospace;
  }

  .post-header {
    margin-bottom: 24px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 16px;
  }

  h1 {
    margin: 10px 0;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.02em;
  }

  .description {
    margin: 0;
    color: var(--text-soft);
  }

  .meta {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    color: var(--text-soft);
    font-size: 0.86rem;
  }

  .tag-row {
    margin-top: 10px;
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .tag {
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.77rem;
    color: var(--text-soft);
    padding: 2px 9px;
  }

  .post-article {
    font-size: 1.03rem;
    line-height: 1.8;
    margin-bottom: 28px;
  }

  .comments-card {
    margin-top: 20px;
  }

  .comments-card h2 {
    margin: 0 0 6px;
    font-size: 1.02rem;
  }

  .comment-note {
    margin: 0 0 12px;
    font-size: 0.9rem;
    color: var(--text-soft);
  }
</style>
