---
import GiscusComments from "../components/GiscusComments.astro";
import PostShare from "../components/PostShare.astro";
import BaseLayout from "./BaseLayout.astro";

interface Frontmatter {
  title: string;
  description?: string;
  pubDate?: string | Date;
  author: string;
  tags: string[];
  group: string;
  discussionId?: string;
}

interface Props {
  frontmatter: Frontmatter;
  slug: string;
}

const { frontmatter, slug } = Astro.props as Props;
const site = Astro.site ?? new URL("https://dplvoah.github.io");
const articleUrl = new URL(`/blog/${slug}/`, site).toString();
---

<BaseLayout title={frontmatter.title}>
  <p class="back-link">
    <a href="/">← 回到首页 / Back to Home</a>
  </p>

  <header class="post-header">
    <h1>{frontmatter.title}</h1>
    {frontmatter.description && <p class="post-description">{frontmatter.description}</p>}

    <div class="post-meta">
      <span>{frontmatter.pubDate && new Date(frontmatter.pubDate).toLocaleDateString("en-US")}</span>
      <span>Author: {frontmatter.author}</span>
      <span>Group: {frontmatter.group}</span>
    </div>

    <div class="post-tags">
      {frontmatter.tags.map((tag) => (
        <span class="pill">#{tag}</span>
      ))}
    </div>
  </header>

  <article class="post-article">
    <slot />
  </article>

  <PostShare
    title={frontmatter.title}
    description={frontmatter.description}
    url={articleUrl}
  />

  <div class="comments-wrap card">
    <div class="comments-intro">
      <h2>评论 / Discussion</h2>
      <p>在下方直接回复；复杂线程可打开 GitHub Discussions 继续。</p>
      <p>Reply below, or continue complex threads in GitHub Discussions.</p>
    </div>

    <GiscusComments />
  </div>
</BaseLayout>

<style>
  .back-link {
    margin: 0 0 20px;
  }

  .back-link a {
    color: var(--color-accent);
    font-weight: 600;
  }

  .post-header {
    margin-bottom: 22px;
  }

  h1 {
    margin: 0 0 12px;
    line-height: 1.12;
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  .post-description {
    margin: 0 0 14px;
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }

  .post-tags {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 4px 10px;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    background: var(--color-surface-soft);
  }

  .post-article {
    font-size: 1.06rem;
    line-height: 1.85;
    margin-bottom: 34px;
  }

  .comments-wrap {
    margin-top: 24px;
    padding: 18px;
  }

  .comments-intro {
    margin-bottom: 18px;
  }

  .comments-intro h2 {
    margin: 0 0 10px;
    font-size: 1.2rem;
  }

  .comments-intro p {
    margin: 4px 0;
    color: var(--color-text-muted);
  }

  @media (min-width: 900px) {
    .comments-wrap {
      padding: 26px;
    }
  }
</style>
