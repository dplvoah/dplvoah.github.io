---
import GiscusComments from "../components/GiscusComments.astro";
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title}>
  <p><a href="/">← Back to Home</a></p>
  <h1>{frontmatter.title}</h1>
  <div class="meta">
    {frontmatter.pubDate && new Date(frontmatter.pubDate).toLocaleDateString("en-US")}
  </div>

  <article>
    <slot />
  </article>

  <div class="comments-wrap">
    <GiscusComments />
  </div>
</BaseLayout>

<style>
  a {
    color: #8ab4ff;
  }

  h1 {
    line-height: 1.2;
    margin-bottom: 12px;
  }

  .meta {
    color: #a1a1aa;
    font-size: 14px;
    margin-bottom: 32px;
  }

  article {
    font-size: 18px;
    line-height: 1.75;
  }

  p {
    margin: 0 0 20px;
  }

  .comments-wrap {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid #27272a;
  }
</style>
